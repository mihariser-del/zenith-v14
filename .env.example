# Single key (backward compat) - will be used if OPENROUTER_API_KEYS is not set
OPENROUTER_API_KEY=sk-or-your-key-here
# Multiple keys rotation (recommended) - comma-separated, auto-rotates on 402/429 exhausted errors
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2,sk-or-key3
# Image generation models, newest first (OpenRouter Image API - Nano Banana class).
# Falls back to the next model on failure, then to free Pollinations/Flux.
IMAGE_MODELS=google/gemini-nano-banana-2.1,google/gemini-3-pro-image,google/gemini-3.1-flash-image,openai/gpt-5.4-image-2
# JWT signing secret. If unset or the known dev value, a strong key is generated and
# persisted to a secret_key.txt (on /data if writable). Recommend setting a strong value here.
SECRET_KEY=change-this-to-a-random-secret-string
DATABASE_URL=sqlite+aiosqlite:///zenith.db

# Owner bootstrap account (created on first boot, never hardcoded).
# There is NO default admin account — admins are created/promoted by the owner.
# Set OWNER_PASSWORD to a long, unique password. If it is left empty, a random
# one-time password is generated and printed once in the deploy logs. Rotate it
# any time from the vault -> EMERGENCY tab ("Emergency Password Change").
OWNER_USERNAME=your-owner-username
OWNER_PASSWORD=change-me-to-a-long-unique-password

# Email delivery for the password-reset flow.
# Railway blocks direct SMTP, so Brevo (HTTPS API, port 443) is preferred.
# Sign up at brevo.com -> Settings -> SMTP & API -> API Keys -> create key,
# then verify your sender email (SMTP_FROM) under Senders & IP.
BREVO_API_KEY=
SMTP_FROM=no-reply@zenith.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=